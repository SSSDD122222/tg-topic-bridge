# 必填：BotFather 创建的机器人 token
BOT_TOKEN=

# 必填：默认目标群的数字 ID（负值，如 -1001234567890），可在群内用 /topic 查看；
# 未用 /bind 分流绑定的用户，消息都走这个默认群
GROUP_CHAT_ID=

# 可选：目标 Topic 的 thread_id（如 25）。留空则用群内命令 /set_topic 保存
TOPIC_THREAD_ID=

# 可选：额外管理员 Telegram 数字 ID（多个用英文逗号分隔）。
# 不填也没关系：群管理员（群主/管理员身份）也能执行管理命令；
# 填了之后，这些 ID 即使不在群管理员列表里也始终拥有管理权限。
ADMIN_USER_IDS=

# 可选：初始白名单用户 ID（英文逗号分隔）。
# 留空 = 默认不允许任何人私聊使用（管理员除外），必须用 /allow 添加后才能使用。
# 这只是初始值，运行中可用群命令 /allow @用户名、/disallow @用户名 动态增删（保存在 data/bridge.json）。
# ALLOWED_USER_IDS=

# 可选：copy=匿名，以机器人名义发送，隐藏群/Topic 痕迹（默认）；
#       forward=保留转发来源，外部用户能看到来自哪个群
BRIDGE_MODE=copy

# 可选：true 时给转发的消息开启保护（接收方无法再转发/保存）
# PROTECT_CONTENT=false

# 可选：状态文件位置（容器内建议保持默认）
# DATA_FILE=data/bridge.json
